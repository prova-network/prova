{
  "name": "prova-helm",
  "productName": "Prova Helm",
  "private": true,
  "version": "0.1.0-pre",
  "description": "Prova Helm \u2014 the operator console for running a Prova prover. Local wallet, on-chain stake/withdraw, auto-update, daemon supervisor. MIT.",
  "main": "main/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "lint:fix": "prettier --write .",
    "test": "run-s build:* && run-s test:*",
    "test:backend": "mocha",
    "test:e2e": "xvfb-maybe cross-env NODE_ENV=test DEBUG=pw:browser* playwright test 'test/e2e/.*.test.js'",
    "clean": "shx rm -rf dist/",
    "build": "run-s clean build:*",
    "build:provad": "bash ../prover/scripts/build-cross.sh",
    "build:webui": "vite build",
    "build:icons": "bash ../brand/gen-app-icons.sh",
    "prepackage": "run-s build:provad build:icons build:webui",
    "package": "shx rm -rf dist/ && run-s prepackage && electron-builder --publish=onTag",
    "install-app-deps": "electron-builder install-app-deps",
    "postinstall": "run-s install-*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prova-network/prova.git",
    "directory": "desktop"
  },
  "keywords": [
    "prova",
    "base",
    "storage",
    "verifiable-storage",
    "pdp"
  ],
  "author": "Prova Network contributors",
  "license": "(Apache-2.0 AND MIT)",
  "bugs": {
    "url": "https://github.com/prova-network/prova/issues"
  },
  "homepage": "https://prova.network",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-toggle-group": "^1.1.7",
    "@radix-ui/react-tooltip": "^1.2.4",
    "chart.js": "^4.4.9",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "electron-log": "^5.4.1",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "ethers": "^6.13.4",
    "keytar": "^7.9.0",
    "ms": "^2.1.3",
    "p-debounce": "^4.0.0",
    "p-retry": "^6.2.0",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.0.0",
    "react-router": "^7.5.2",
    "split2": "^4.2.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.0",
    "@types/mocha": "^10.0.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.4",
    "@types/split2": "^4.2.3",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/ui": "^3.0.9",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.4",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.0.9",
    "xvfb-maybe": "^0.2.1"
  },
  "overrides": {
    "node-abi": "^3.51.0"
  }
}
